// JSON5 포맷을 사용하여 주석(//)을 지원하며, Zenoh 브릿지 내부의 ROS 2 DDS 플러그인에 대한 설정을 담고 있습니다.
{
  plugins: {
    ros2dds: {

      // 다른 로봇 namespace가 이 로봇의 DDS로 넘어오는 것을 차단
      // 'deny' 규칙은 여기에 명시된 정규표현식 패턴과 일치하는 토픽들이 
      // Zenoh를 통해 외부에서 현재 로봇의 내부 네트워크(DDS)로 들어오는 것을 원천 차단합니다.
      deny: {

        // 퍼블리셔(발행자) 차단 규칙입니다. 
        publishers: [
          // "^/robot[0-9]+/.*$" 패턴은 '/robot1/odom', '/robot2/telemetry' 등 
          // 다른 로봇의 네임스페이스가 붙은 모든 토픽을 현재 로봇의 로컬 네트워크로 전파하지 않겠다는 뜻입니다. 
          // 즉, 로봇 1은 자신의 센서 데이터만 보면 되지, 로봇 2나 3의 데이터를 수신하여 리소스를 낭비할 필요가 없습니다.
          "^/robot[0-9]+/.*$",
          
          // "^/rosout$", "^/parameter_events$" 패턴은 ROS 2 시스템이 기본적으로 발생시키는 
          // 로깅 및 파라미터 이벤트 토픽입니다. 이 시스템 토픽들이 브릿지를 타고 넘어가 네트워크 대역폭을 잡아먹지 못하도록 막습니다.
          "^/rosout$",
          "^/parameter_events$"
        ],

        // 아래 항목들도 마찬가지로 구독자, 서비스, 액션 통신에 대해 
        // 다른 로봇의 네임스페이스(^/robot[0-9]+/.*$)가 개입하는 것을 철저하게 차단하여, 
        // 각 로봇의 통신 도메인을 독립적으로 안전하게 격리(Isolation)합니다.
        subscribers: [
          "^/robot[0-9]+/.*$"
        ],

        service_servers: [
          "^/robot[0-9]+/.*$"
        ],

        service_clients: [
          "^/robot[0-9]+/.*$"
        ],

        action_servers: [
          "^/robot[0-9]+/.*$"
        ],

        action_clients: [
          "^/robot[0-9]+/.*$"
        ]
      }
    }
  }
}