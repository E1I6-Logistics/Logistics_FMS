# Copy to simulation/.env. Never commit the .env file.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:1b
# LLM 입력은 원본 test.geojson 또는 축약된 test_compact_graph.geojson 중 선택한다.
LLM_ROUTE_GRAPH=test_int.geojson
# 실패 시 최대 요청 횟수. 유료 API 사용 시 비용 증가에 주의한다.
LLM_MAX_ATTEMPTS=1
# provider HTTP 요청 제한 시간(초)
LLM_TIMEOUT_SECONDS=60
# 전체 경로 판단의 실시간 목표 시간(초)
PATH_DECISION_DEADLINE_SECONDS=0.15
# OLLAMA_HOST=http://localhost:11434

OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Anthropic을 사용할 때 LLM_PROVIDER=anthropic으로 변경하고 아래 값을 채운다.
# Structured Outputs를 지원하는 Claude 모델 ID를 사용한다.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Jetson에서는 Hugging Face Laya를 CUDA로 직접 실행한다.
ROUTE_SELECTOR=laya
LAYA_HF_MODEL=convaiinnovations/laya-multilingual
LAYA_DEVICE=cuda:0
LAYA_REQUIRE_CUDA=true
# Jetson에서 사용 가능한 약 4.5GB RAM을 고려한 입력 토큰 상한
LAYA_MAX_LENGTH=4096
# AllRoutes 시험처럼 선택지가 많을 때만 전체/선택지 토큰 예산을 함께 늘린다.
# LAYA_MAX_LENGTH=8192
# LAYA_HEAD_MAX_LENGTH=2048
# 선택 사항: Hugging Face 캐시 위치와 비공개 모델 토큰
# HF_HOME=/home/sein/.cache/huggingface
# HF_TOKEN=

# Kev 공식 runtime 서버를 사용할 때 ROUTE_SELECTOR=kev로 변경한다.
# Kev 서버는 한 번에 하나만 실행하며 두 모델 모두 8011 포트를 사용한다.
# Jetson/PC 경량: python -m kev.serve --run jaredpalmer/kev-0.8b@v1.0 --port 8011
# PC 고성능: python -m kev.serve --run jaredpalmer/kev-4b@v1.0 --port 8011
# 실행한 checkpoint에 맞춰 KEV_MODEL을 kev-08b 또는 kev-4b로 지정한다.
# ROUTE_SELECTOR=kev
KEV_HOST=http://127.0.0.1:8011
KEV_MODEL=kev-08b
KEV_REQUIRE_CUDA=true
KEV_TIMEOUT_SECONDS=60
# KEV_API_KEY=
