# Copy to simulation/.env. Never commit the .env file.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:1b
# LLM 입력은 원본 test.geojson 또는 축약된 test_compact_graph.geojson 중 선택한다.
LLM_ROUTE_GRAPH=test_compact_graph.geojson
# 실패 시 최대 요청 횟수. 유료 API 사용 시 비용 증가에 주의한다.
LLM_MAX_ATTEMPTS=1
# provider HTTP 요청 제한 시간(초)
LLM_TIMEOUT_SECONDS=60
# 전체 경로 판단의 실시간 목표 시간(초)
PATH_DECISION_DEADLINE_SECONDS=0.15
# OLLAMA_HOST=http://localhost:11434

OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
