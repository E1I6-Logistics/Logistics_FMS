FMS_ROBOT_MODE=simulation

FMS_MAP_YAML=my_map.yaml

FMS_ROUTE_GRAPH=test.geojson

FMS_CORS_ORIGINS=*

# Logging and connection diagnostics
FMS_LOG_LEVEL=INFO
FMS_LOG_MAX_BYTES=20971520
FMS_LOG_BACKUP_COUNT=10
FMS_SLOW_REQUEST_MS=1000
FMS_ZENOH_STALE_GRACE_SECONDS=6.0
FMS_ZENOH_REST_TIMEOUT_SECONDS=2.0
FMS_ZENOH_CONNECTION_CACHE_TTL_SECONDS=3.0

# MQTT / OMX
FMS_MQTT_ENABLED=true
FMS_MQTT_BROKER_HOST=127.0.0.1
FMS_MQTT_BROKER_PORT=1883
FMS_MQTT_DEVICE_TIMEOUT_SECONDS=5.0
FMS_PICKUP_OMX_MAP=5:omx1,6:omx2
FMS_WORKSTATION_OMX_MAP=3:omx3,4:omx4
FMS_ROBOT_WAITING_NODE_MAP=robot1:0,robot2:1,robot3:2

# Node 3/4/5의 0은 marker ID 결정 후 변경할 자리표시자
FMS_ARUCO_MARKER_MAP=3:0,4:0,5:0,6:25

# 실제 도착 판정
FMS_ARRIVAL_TOLERANCE_METERS=0.2
FMS_POSE_STALE_SECONDS=3.0
